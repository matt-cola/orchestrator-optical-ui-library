{
  "name": "orchestrator-optical-ui-library",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "UI components for the Workflow Orchestrator optical module (orchestrator-optical): optical network map page",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workfloworchestrator/orchestrator-optical-ui-library.git"
  },
  "keywords": [
    "orchestrator",
    "workflow orchestrator",
    "optical",
    "network",
    "map"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "generate-leaflet-css": "node scripts/generate-leaflet-css.mjs",
    "build": "npm run generate-leaflet-css && tsup",
    "dev": "tsup --watch",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "prettier": "prettier -c \"{src,example,scripts}/**/*.{ts,tsx,js,mjs,json,md}\" \"*.{json,md,ts}\"",
    "prettier-fix": "prettier --write \"{src,example,scripts}/**/*.{ts,tsx,js,mjs,json,md}\" \"*.{json,md,ts}\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1"
  },
  "peerDependencies": {
    "@elastic/eui": ">=112.0.0",
    "@orchestrator-ui/orchestrator-ui-components": ">=10.0.0",
    "next": ">=15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@elastic/eui": "^122.1.0",
    "@orchestrator-ui/orchestrator-ui-components": "10.4.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "next": "^16.0.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
